# VisionBoard Backend — Environment Variables
# Copy to .env and fill in values. Never commit .env to source control.

# ────────────────────────────────────────────
# Database (same Supabase/Postgres as frontend)
# ────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/DATABASE?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# ────────────────────────────────────────────
# Auth (share the same secret as Next.js AUTH_SECRET)
# ────────────────────────────────────────────
AUTH_SECRET="your-nextauth-secret-here"

# ────────────────────────────────────────────
# Anthropic
# ────────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."

# ────────────────────────────────────────────
# Server
# ────────────────────────────────────────────
PORT=4000
FRONTEND_URL="http://localhost:3000"
NODE_ENV="development"
